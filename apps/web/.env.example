# Cloud Run API URL in production; empty in dev (Vite proxies /api to localhost:8787).
VITE_API_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Local only — pairs with AUTH_DEV_BYPASS on the API.
VITE_AUTH_DEV_BYPASS=true
# Server-side GTM collect endpoint incl. path, e.g. https://sgtm.brand.sa/retrgtr. Empty = collector posts to the API.
VITE_COLLECT_URL=
